diff --git a/fs/f2fs/x683_gc_vendor_reconstruction.c b/fs/f2fs/x683_gc_vendor_reconstruction.c
new file mode 100644
--- /dev/null
+++ b/fs/f2fs/x683_gc_vendor_reconstruction.c
@@
+/*
+ * X683/H694 Transsion F2FS vendor-policy reconstruction.
+ *
+ * Binary authority:
+ *   X683/H694 Image, helper 0x35cc18 and post-GC policy 0x366cd4.
+ *
+ * This file is intentionally an offset-backed semantic reconstruction.
+ * It does not claim recovery of the original proprietary source names.
+ *
+ * It is suitable for compilation in a kernel-4.14 F2FS tree after adding
+ * the object to the fs/f2fs Makefile. Integration into gc.c/segment.c
+ * requires the surrounding historical X683-era source tree.
+ */
+
+#include "f2fs.h"
+
+#define X683_SBI_U32(sbi, off) \
+	(*(const u32 *)((const char *)(sbi) + (off)))
+#define X683_SBI_S32(sbi, off) \
+	(*(const s32 *)((const char *)(sbi) + (off)))
+
+#define X683_NR_WB_CP_DATA	0x444
+#define X683_NR_WB_DATA		0x448
+#define X683_NR_RD_DATA		0x44c
+#define X683_NR_RD_NODE		0x450
+#define X683_NR_RD_META		0x454
+#define X683_NR_DIO_WRITE	0x458
+#define X683_NR_DIO_READ		0x45c
+#define X683_GC_MODE		0x534
+
+static inline u64 x683_umulh(u64 a, u64 b)
+{
+	return (u64)(((__uint128_t)a * (__uint128_t)b) >> 64);
+}
+
+static inline bool x683_io_active(const struct f2fs_sb_info *sbi)
+{
+	return X683_SBI_U32(sbi, X683_NR_WB_CP_DATA) ||
+	       X683_SBI_U32(sbi, X683_NR_WB_DATA) ||
+	       X683_SBI_U32(sbi, X683_NR_RD_DATA) ||
+	       X683_SBI_U32(sbi, X683_NR_RD_NODE) ||
+	       X683_SBI_U32(sbi, X683_NR_RD_META) ||
+	       X683_SBI_U32(sbi, X683_NR_DIO_WRITE) ||
+	       X683_SBI_U32(sbi, X683_NR_DIO_READ);
+}
+
+/* Semantic reconstruction of Image+0x35cc18. */
+bool x683_gc_policy_predicate(struct f2fs_sb_info *sbi,
+				      unsigned int selector, u64 delta)
+{
+	const u8 *sm = (const u8 *)SM_I(sbi);
+	const u64 reciprocal = 0x28f5c28f5c28f5c3ULL;
+	u64 rate, p, v;
+
+	rate = (delta * *(const u32 *)(sm + 0x10)) >> 2;
+	p = x683_umulh(rate, reciprocal);
+
+	switch (selector) {
+	case 0:
+		v = ((u64)*(const u32 *)(sm + 0xa8) * 3) >> 9;
+		return v < (p >> 3);
+	case 1:
+		v = *(const u32 *)(sm + 0x7c);
+		return p > (v >> 7) &&
+		       ((*(const u32 *)(sm + 0x7c) >> 5) < 0xc35);
+	case 2:
+		return *(const u32 *)((const char *)sbi->sb->s_fs_info + 0x1c8) == 0;
+	case 3:
+		v = *(const u64 *)((const char *)sbi + 0x220);
+		v += *(const u64 *)((const char *)sbi + 0x250);
+		v += *(const u64 *)((const char *)sbi + 0x280);
+		v += *(const u64 *)((const char *)sbi + 0x2b0);
+		v += *(const u64 *)((const char *)sbi + 0x2e0);
+		v = (v * 3) >> 9;
+		return v < (p >> 3);
+	case 4:
+		v = (u64)((s64)X683_SBI_S32(sbi, 0x3a4) * 80);
+		v += (u64)((s64)X683_SBI_S32(sbi, 0x3bc) * 64);
+		v >>= 12;
+		return v < (p >> 3);
+	case 5:
+		return X683_SBI_S32(sbi, 0x43c) <
+		       (s64)(x683_umulh(delta, 0xcccccccccccccccdULL) >> 2);
+	default:
+		/* Binary jump-table default is the selector-2 body. */
+		return *(const u32 *)((const char *)sbi->sb->s_fs_info + 0x1c8) == 0;
+	}
+}
+
+/* Confirmed post-GC I/O discriminator from 0x366cd4. */
+bool x683_gc_io_gate(struct f2fs_sb_info *sbi)
+{
+	if (X683_SBI_U32(sbi, X683_GC_MODE) == 3)
+		return true;
+	return x683_io_active(sbi);
+}
